; Father & Son — prototype 0.1. Open this file with Godot 4.6 stable.
config_version=5

[application]
config/name="Father & Son — 0.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Una strada, un distributore, un padre e suo figlio."

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.14, 0.17, 0.18, 1)

[layer_names]
3d_physics/layer_1="Environment"
3d_physics/layer_2="Father"
3d_physics/layer_3="Child"
3d_physics/layer_4="Enemy"

[navigation]
3d/default_cell_size=0.2
3d/default_cell_height=0.1
