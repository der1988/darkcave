{
  "name": "liminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "dev": "npm run build:native && vite --host 0.0.0.0",
    "build": "npm run build:native && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build:native && tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "@live-codes/clang-wasm": "^0.3.0",
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
